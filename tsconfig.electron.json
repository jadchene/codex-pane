{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "electron"]
  },
  "include": ["electron/main/**/*.ts", "electron/shared/**/*.ts", "packages/protocol/src/**/*.ts"],
  "exclude": ["electron/preload", "packages/protocol/src/generated"]
}
