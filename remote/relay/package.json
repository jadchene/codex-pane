{
  "name": "@codex-pane/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && npm run build:bootstrap && esbuild src/server.ts --bundle --platform=node --format=esm --target=node24 --packages=external --alias:@codex-pane/remote-protocol=../../packages/remote-protocol/src/index.ts --outfile=dist/server.js",
    "build:bootstrap": "esbuild src/mobile-bootstrap.js --bundle --platform=browser --format=esm --target=es2022 --minify --legal-comments=none --outfile=public/bootstrap.js",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@codex-pane/remote-protocol": "file:../../packages/remote-protocol",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild": true
  }
}
